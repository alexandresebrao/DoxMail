{
    "app-id": "org.doxia.DoxMail",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "doxmail",
    "build-options": {
        "cflags": "-O2 -g -Wno-deprecated-declarations",
        "cxxflags": "-O2 -g -Wno-deprecated-declarations"
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/share/gtk-doc",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--filesystem=xdg-download",
        "--filesystem=xdg-config/gtk-4.0:ro",
        "--filesystem=~/.local/state/doxia/current:ro",
        "--filesystem=~/.pki:rw",
        "--filesystem=xdg-config/pki:rw",
        "--filesystem=~/.config/evolution:ro",
        "--filesystem=~/.local/share/evolution:ro",
        "--filesystem=~/.cache/evolution:ro",
        "--filesystem=~/.config/dconf:ro",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.secrets"
    ],
    "modules": [
        {
            "name": "intltool",
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://launchpad.net/intltool/trunk/0.51.0/+download/intltool-0.51.0.tar.gz",
                    "sha256": "67c74d94196b153b774ab9f89b2fa6c6ba79352407037c8c14d5aeb334e959cd"
                }
            ]
        },
        {
            "name": "libical",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_INSTALL_LIBDIR:PATH=/app/lib",
                "-DBUILD_SHARED_LIBS:BOOL=ON",
                "-DGOBJECT_INTROSPECTION:BOOL=OFF",
                "-DICAL_BUILD_DOCS:BOOL=OFF",
                "-DICAL_GLIB_VAPI:BOOL=OFF",
                "-DICAL_GLIB:BOOL=ON",
                "-DLIBICAL_BUILD_TESTING:BOOL=OFF"
            ],
            "cleanup": [
                "/libexec/libical"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libical/libical/releases/download/v3.0.20/libical-3.0.20.tar.gz",
                    "sha256": "e73de92f5a6ce84c1b00306446b290a2b08cdf0a80988eca0a2c9d5c3510b4c2"
                }
            ]
        },
        {
            "name": "cmark",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_INSTALL_LIBDIR:PATH=/app/lib",
                "-DBUILD_TESTING:BOOL=OFF"
            ],
            "cleanup": [
                "/bin",
                "/share"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/commonmark/cmark/archive/refs/tags/0.31.0.tar.gz",
                    "sha256": "bbcb8f8c03b5af33fcfcf11a74e9499f20a9043200b8552f78a6e8ba76e04d11"
                }
            ]
        },
        {
            "name": "bogofilter",
            "config-opts": [
                "--with-database=sqlite3",
                "--disable-rpath"
            ],
            "cleanup": [
                "/etc"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://downloads.sourceforge.net/project/bogofilter/bogofilter-stable/bogofilter-1.2.5.tar.xz",
                    "sha256": "3248a1373bff552c500834adbea4b6caee04224516ae581fb25a4c6a6dee89ea"
                }
            ]
        },
        {
            "name": "evolution-data-server",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DDBUS_SERVICES_PREFIX=org.doxia.DoxMail",
                "-DEXTENSIONS_DIR=/app/evolution/extensions",
                "-DENABLE_FILE_LOCKING=fcntl",
                "-DENABLE_DOT_LOCKING=OFF",
                "-DENABLE_GTK=OFF",
                "-DENABLE_GTK4=ON",
                "-DENABLE_OAUTH2_WEBKITGTK=OFF",
                "-DENABLE_OAUTH2_WEBKITGTK4=ON",
                "-DENABLE_GOA=OFF",
                "-DENABLE_WEATHER=OFF",
                "-DENABLE_CANBERRA=OFF",
                "-DENABLE_EXAMPLES=OFF",
                "-DENABLE_TESTS=OFF",
                "-DENABLE_INTROSPECTION=OFF",
                "-DENABLE_VALA_BINDINGS=OFF",
                "-DENABLE_INSTALLED_TESTS=OFF",
                "-DENABLE_GTK_DOC=OFF",
                "-DWITH_OPENLDAP=OFF",
                "-DWITH_KRB5=OFF",
                "-DWITH_LIBDB=OFF",
                "-DWITH_PRIVATE_DOCS=OFF",
                "-DWITH_PHONENUMBER=OFF",
                "-DWITH_SYSTEMDUSERUNITDIR=OFF"
            ],
            "cleanup": [
                "/etc/xdg",
                "/share/dbus-1"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/evolution-data-server/3.60/evolution-data-server-3.60.2.tar.xz",
                    "sha256": "2084dbdac396371b365d504c1ff45866ba8dca2f1252e5da1d3d9c33abdc1286"
                }
            ],
            "post-install": [
                "install -d /app/evolution/extensions"
            ]
        },
        {
            "name": "doxmail",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "cflags": "-DTEMP_HOME=1"
            },
            "config-opts": [
                "-DWITH_GTK4=ON",
                "-DWITH_HELP=OFF",
                "-DWITH_GLADE_CATALOG=OFF",
                "-DWITH_OPENLDAP=OFF",
                "-DWITH_BOGOFILTER=/app/bin/bogofilter",
                "-DENABLE_ALARM_NOTIFY_MODULE=OFF",
                "-DENABLE_AUTOAR=OFF",
                "-DENABLE_CANBERRA=OFF",
                "-DENABLE_CONTACT_MAPS=OFF",
                "-DENABLE_GNOME_DESKTOP=OFF",
                "-DENABLE_GSPELL=OFF",
                "-DENABLE_GTK_DOC=OFF",
                "-DENABLE_INSTALLED_TESTS=OFF",
                "-DENABLE_PST_IMPORT=OFF",
                "-DENABLE_TEXT_HIGHLIGHT=OFF",
                "-DENABLE_WEATHER=OFF",
                "-DENABLE_YTNEF=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "path": "../..",
                    "branch": "doxmail"
                }
            ],
            "post-install": [
                "glib-compile-schemas /app/share/glib-2.0/schemas"
            ]
        },
        {
            "name": "dconf-gio-module",
            "buildsystem": "meson",
            "config-opts": [
                "-Dbash_completion=false",
                "-Dman=false",
                "-Dvapi=false",
                "-Dsystemduserunitdir=no"
            ],
            "post-install": [
                "install -d /app/lib/doxmail-migrate/gio-modules",
                "mv /app/lib/gio/modules/libdconfsettings.so /app/lib/doxmail-migrate/gio-modules/"
            ],
            "cleanup": [
                "/bin",
                "/libexec",
                "/share/dbus-1",
                "/share/bash-completion",
                "/include",
                "/lib/libdconf.so*",
                "/lib/pkgconfig",
                "/lib/gio"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/dconf/0.40/dconf-0.40.0.tar.xz",
                    "sha256": "cf7f22a4c9200421d8d3325c5c1b8b93a36843650c9f95d6451e20f0bcb24533"
                }
            ]
        },
        {
            "name": "doxmail-wrapper",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "file",
                    "path": "doxmail-wrapper.sh.in"
                },
                {
                    "type": "file",
                    "path": "migrate-settings.py"
                },
                {
                    "type": "file",
                    "path": "org.doxia.DoxMail.flatpak.gschema.override"
                }
            ],
            "build-commands": [
                "sed -e \"s|@SOURCES_SERVICE@|$(pkg-config --variable=sourcesdbusservicename evolution-data-server-1.2)|\" -e \"s|@ADDRESSBOOK_SERVICE@|$(pkg-config --variable=addressbookdbusservicename evolution-data-server-1.2)|\" -e \"s|@CALENDAR_SERVICE@|$(pkg-config --variable=calendardbusservicename evolution-data-server-1.2)|\" doxmail-wrapper.sh.in > doxmail-wrapper.sh",
                "! grep -q \"@[A-Z_]*_SERVICE@\" doxmail-wrapper.sh && grep -q org.doxia.DoxMail.org.gnome.evolution.dataserver.Sources doxmail-wrapper.sh",
                "mv /app/bin/doxmail /app/bin/doxmail.bin",
                "install -m 755 doxmail-wrapper.sh /app/bin/doxmail",
                "install -m 755 migrate-settings.py /app/libexec/doxmail-migrate-settings",
                "install -m 644 org.doxia.DoxMail.flatpak.gschema.override /app/share/glib-2.0/schemas/",
                "glib-compile-schemas /app/share/glib-2.0/schemas"
            ]
        }
    ]
}
