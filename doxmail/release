#!/bin/bash

# Publishes DoxMail for DoxIA: runs the "DoxMail Flatpak" workflow, which
# builds doxmail/flatpak/org.doxia.DoxMail.json from origin/doxmail and
# publishes the signed Flatpak repository on GitHub Pages; DoxIA installs
# DoxMail from there and `flatpak update` brings the new build.
#
#   doxmail/release [--no-wait]
#
# HEAD must be origin/doxmail: the workflow builds that branch.

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."
repo=alexandresebrao/DoxMail
workflow=doxmail-flatpak.yml

git fetch -q origin doxmail
if [[ $(git rev-parse HEAD) != $(git rev-parse origin/doxmail) ]]; then
  echo "HEAD ($(git rev-parse --short=10 HEAD)) is not origin/doxmail: push it first." >&2
  exit 1
fi

gh workflow run "$workflow" -R "$repo" --ref doxmail
echo "Started the Flatpak build of $(git rev-parse --short=10 HEAD)." >&2
[[ ${1:-} == --no-wait ]] && exit 0

# the run shows up a moment after the dispatch
sleep 5
run=$(gh run list -R "$repo" --workflow "$workflow" --branch doxmail --limit 1 --json databaseId --jq '.[0].databaseId')
gh run watch "$run" -R "$repo" --exit-status
echo "Published: https://alexandresebrao.github.io/DoxMail/doxmail.flatpakrepo"
