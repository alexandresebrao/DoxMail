        <col id="0" translatable="yes">FTP (with login)</col>
      </row>
      <row>
        <col id="0" translatable="yes">Windows share</col>
      </row>
      <row>
        <col id="0" translatable="yes">WebDAV (HTTP)</col>
      </row>
      <row>
