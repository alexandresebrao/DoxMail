      </row>
      <row>
        <col id="0" translatable="yes">Custom Location</col>
      </row>
    </data>
  </object>
  <object class="GtkNotebook" id="publishing toplevel">
    <property name="focusable">1</property>
    <property name="margin-bottom">6</property>
    <property name="margin-top">6</property>
    <property name="margin-end">6</property>
    <property name="margin-start">6</property>
    <property name="hexpand">1</property>
    <property name="vexpand">1</property>
    <child>
      <object class="GtkNotebookPage">
        <property name="child">
          <object class="GtkBox" id="vbox7">
            <property name="orientation">vertical</property>
            <property name="margin-bottom">6</property>
            <property name="margin-top">6</property>
            <property name="margin-end">6</property>
            <property name="margin-start">6</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel" id="label22">
                <property name="valign">center</property>
                <property name="label" translatable="1">General</property>
                <property name="xalign">0</property>
                <attributes>
                  <attribute name="weight" value="bold" />
                </attributes>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbox14">
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel" id="label25">
                    <property name="halign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid">
                    <property name="hexpand">1</property>
                    <property name="column_spacing">6</property>
                    <property name="row_spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label28">
                        <property name="label" translatable="1">_Publish as:</property>
                        <property name="use_underline">1</property>
                        <property name="mnemonic_widget">type_selector</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="type_selector">
                        <property name="model">model1</property>
                        <child>
                          <object class="GtkCellRendererText" id="renderer1" />
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label29">
                        <property name="label" translatable="1">Publishing _Frequency:</property>
                        <property name="use_underline">1</property>
                        <property name="mnemonic_widget">publish_frequency</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="publish_frequency">
                        <property name="model">model2</property>
                        <child>
                          <object class="GtkCellRendererText" id="renderer2" />
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="fb_duration_label">
                        <property name="label" translatable="1">Time _duration:</property>
                        <property name="use_underline">1</property>
                        <property name="mnemonic_widget">fb_duration_spin</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="hbox20">
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                        <child>
                          <object class="GtkSpinButton" id="fb_duration_spin">
                            <property name="halign">center</property>
                            <property name="focusable">1</property>
                            <property name="adjustment">adjustment1</property>
                            <property name="climb_rate">1</property>
