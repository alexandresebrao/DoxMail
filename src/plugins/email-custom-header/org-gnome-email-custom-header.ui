<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkDialog" id="email-custom-header-dialog">
    <property name="visible">1</property>
    <property name="title" translatable="1">Email Custom Header</property>
    <property name="resizable">0</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="email-custom-header-vbox">
        <child>
          <object class="GtkGrid" id="email-custom-header-options">
            <property name="halign">center</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <property name="column_spacing">12</property>
            <property name="row_spacing">12</property>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-11">helpbutton1</action-widget>
      <action-widget response="-6">cancelbutton1</action-widget>
      <action-widget response="-5">okbutton1</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area1">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <child>
          <object class="GtkButton" id="helpbutton1">
            <property name="hexpand">1</property>
            <property name="label" translatable="1">_Help</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="cancelbutton1">
            <property name="hexpand">1</property>
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="okbutton1">
            <property name="hexpand">1</property>
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <property name="halign">end</property>
      </object>
    </child>
  </object>
</interface>