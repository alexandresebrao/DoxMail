<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="cert-manager-config-control">
    <property name="title">window1</property>
    <property name="child">
      <object class="GtkNotebook" id="cert-manager-notebook">
        <property name="focusable">1</property>
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkBox" id="vbox4">
                <property name="orientation">vertical</property>
                <property name="margin-bottom">6</property>
                <property name="margin-top">6</property>
                <property name="margin-end">6</property>
                <property name="margin-start">6</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label57">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">You have certificates from these organizations that identify you:</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox6">
                    <property name="vexpand">1</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow4">
                        <property name="hexpand">1</property>
                        <property name="focusable">1</property>
                        <property name="child">
                          <object class="GtkTreeView" id="yourcerts-treeview">
                            <property name="name">yourcerts</property>
                            <property name="focusable">1</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection" />
                            </child>
                            <accessibility>
                              <property name="label" translatable="1">Certificates Table</property>
                            </accessibility>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="vbuttonbox1">
                        <property name="orientation">vertical</property>
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton" id="your-view-button">
                            <property name="label" translatable="1">_View</property>
                            <property name="sensitive">0</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="your-backup-button">
                            <property name="sensitive">0</property>
                            <property name="focusable">1</property>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">6</property>
                                <property name="halign">center</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">document-save</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="1" comments="This is a verb, as in &quot;make a backup&quot;.">_Backup</property>
                                    <property name="use-underline">1</property>
                                    <property name="mnemonic-widget">your-backup-button</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="your-backup-all-button">
                            <property name="focusable">1</property>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">6</property>
                                <property name="halign">center</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">document-save</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="1">Backup _All</property>
                                    <property name="use-underline">1</property>
                                    <property name="mnemonic-widget">your-backup-all-button</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="your-import-button">
                            <property name="label" translatable="1">I_mport</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="your-delete-button">
                            <property name="label" translatable="1">_Delete</property>
                            <property name="sensitive">0</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="label54">
                <property name="label" translatable="1">Your Certificates</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkNotebookPage">
            <property name="position">1</property>
            <property name="child">
              <object class="GtkBox" id="vbox5">
                <property name="orientation">vertical</property>
                <property name="margin-bottom">6</property>
                <property name="margin-top">6</property>
                <property name="margin-end">6</property>
                <property name="margin-start">6</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label60">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">You have certificates on file that identify these people:</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox7">
                    <property name="vexpand">1</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow5">
                        <property name="hexpand">1</property>
                        <property name="focusable">1</property>
                        <property name="child">
                          <object class="GtkTreeView" id="contactcerts-treeview">
                            <property name="name">contactcerts</property>
                            <property name="focusable">1</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection" />
                            </child>
                            <accessibility>
                              <property name="label" translatable="1">Certificates Table</property>
                            </accessibility>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="vbuttonbox2">
                        <property name="orientation">vertical</property>
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton" id="contact-view-button">
                            <property name="label" translatable="1">_View</property>
                            <property name="sensitive">0</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="contact-edit-button">
                            <property name="label" translatable="1">_Edit</property>
                            <property name="sensitive">0</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="contact-import-button">
                            <property name="label" translatable="1">I_mport</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="contact-delete-button">
                            <property name="label" translatable="1">_Delete</property>
                            <property name="sensitive">0</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="label55">
                <property name="label" translatable="1">Contact Certificates</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkNotebookPage">
            <property name="position">2</property>
            <property name="child">
              <object class="GtkBox" id="vbox6">
                <property name="orientation">vertical</property>
                <property name="margin-bottom">6</property>
                <property name="margin-top">6</property>
                <property name="margin-end">6</property>
                <property name="margin-start">6</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label62">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">You have certificates on file that identify these certificate authorities:</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox8">
                    <property name="vexpand">1</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow6">
                        <property name="hexpand">1</property>
                        <property name="focusable">1</property>
                        <property name="child">
                          <object class="GtkTreeView" id="authoritycerts-treeview">
                            <property name="name">authoritycerts</property>
                            <property name="focusable">1</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection" />
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="vbuttonbox3">
                        <property name="orientation">vertical</property>
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton" id="authority-view-button">
                            <property name="label" translatable="1">_View</property>
                            <property name="sensitive">0</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="authority-edit-button">
                            <property name="label" translatable="1">_Edit</property>
                            <property name="sensitive">0</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="authority-import-button">
                            <property name="label" translatable="1">I_mport</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="authority-delete-button">
                            <property name="label" translatable="1">_Delete</property>
                            <property name="sensitive">0</property>
                            <property name="focusable">1</property>
                            <property name="use_underline">1</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="label56">
                <property name="label" translatable="1">Authorities</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </object>
  <object class="GtkDialog" id="ca-trust-dialog">
    <property name="title" translatable="1">Certificate Authority Trust</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox2">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="vbox9">
            <property name="orientation">vertical</property>
            <property name="margin-bottom">12</property>
            <property name="margin-top">12</property>
            <property name="margin-end">12</property>
            <property name="margin-start">12</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel" id="ca-trust-label">
                <property name="valign">center</property>
                <property name="xalign">0</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="ssl_trust_checkbutton">
                <property name="valign">center</property>
                <property name="label" translatable="1">Trust this CA to identify _websites.</property>
                <property name="focusable">1</property>
                <property name="use_underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="email_trust_checkbutton">
                <property name="valign">center</property>
                <property name="label" translatable="1">Trust this CA to identify _email users.</property>
                <property name="focusable">1</property>
                <property name="use_underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="objsign_trust_checkbutton">
                <property name="valign">center</property>
                <property name="label" translatable="1">Trust this CA to identify _software developers.</property>
                <property name="focusable">1</property>
                <property name="use_underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label66">
                <property name="valign">center</property>
                <property name="label" translatable="1">Before trusting this CA for any purpose, you should examine its certificate and its policy and procedures (if available).</property>
                <property name="wrap">1</property>
                <property name="xalign">0</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-3">view_certificate_button</action-widget>
      <action-widget response="-6">cancelbutton</action-widget>
      <action-widget response="-5">okbutton</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area2">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <child>
          <object class="GtkButton" id="view_certificate_button">
            <property name="label" translatable="1">_View Certificate</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="cancelbutton">
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="okbutton">
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <property name="halign">end</property>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="cert-trust-dialog">
    <property name="title" translatable="1">Email Certificate Trust Settings</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox3">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="vbox8">
            <property name="orientation">vertical</property>
            <property name="margin-bottom">12</property>
            <property name="margin-top">12</property>
            <property name="margin-end">12</property>
            <property name="margin-start">12</property>
            <child>
              <object class="GtkLabel" id="trust-label">
                <property name="valign">center</property>
                <property name="margin-bottom">12</property>
                <property name="width-chars">60</property>
                <property name="max-width-chars">60</property>
                <property name="wrap">1</property>
                <property name="xalign">0.0</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="cert-trust">
                <property name="valign">center</property>
                <property name="label" translatable="1">Trust the authenticity of this certificate</property>
                <property name="focusable">1</property>
                <property name="use_underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="cert-notrust">
                <property name="valign">center</property>
                <property name="label" translatable="1">Do not trust the authenticity of this certificate</property>
                <property name="focusable">1</property>
                <property name="use_underline">1</property>
                <property name="group">cert-trust</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-3">editca</action-widget>
      <action-widget response="-5">editok</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area3">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <child>
          <object class="GtkButton" id="editca">
            <property name="label" translatable="1">_Edit CA Trust</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="editok">
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <property name="halign">end</property>
      </object>
    </child>
  </object>
  <object class="GtkListStore" id="model1">
    <columns>
      <column type="gchararray" />
    </columns>
    <data>
      <row>
        <col id="0" translatable="yes">a</col>
      </row>
      <row>
        <col id="0" translatable="yes">b</col>
      </row>
    </data>
  </object>
  <object class="GtkBox" id="cert_selector_vbox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox" id="hbox5">
        <property name="margin-bottom">6</property>
        <property name="margin-top">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkLabel" id="label67">
            <property name="halign">center</property>
            <property name="label" translatable="1">C_ertificate:</property>
            <property name="use_underline">1</property>
            <property name="mnemonic_widget">cert_combobox</property>
          </object>
        </child>
        <child>
          <object class="GtkComboBox" id="cert_combobox">
            <property name="halign">center</property>
            <property name="model">model1</property>
            <child>
              <object class="GtkCellRendererText" id="renderer1" />
              <attributes>
                <attribute name="text">0</attribute>
              </attributes>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>