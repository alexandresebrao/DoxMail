                            <property name="wrap">1</property>
                            <property name="xalign">0.0</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label-publish-auth-info">
                            <property name="label" translatable="1">Specify login user name as part of the URL in case the server requires authentication, like: https://USER@example.com/</property>
                            <property name="wrap">1</property>
                            <property name="xalign">0.0</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <property name="tab">
          <object class="GtkLabel" id="label3">
            <property name="label" translatable="1">Publishing Information</property>
          </object>
        </property>
      </object>
    </child>
  </object>
  <object class="GtkSizeGroup" id="day_begins_ends_sizegroup">
    <widgets>
      <widget name="day_end_label" />
      <widget name="day_start_label" />
    </widgets>
  </object>
</interface>