<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <requires lib="evolution" version="0.0" />
  <object class="GtkPopover" id="menu-editor-config">
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-phone">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Telephone</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-sip">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show SIP Address</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-im">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Instant Messaging</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="menuitem1">
        </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-web">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Web Addresses</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-job">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Job section</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-dates">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Dates</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-misc">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Miscellaneous</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="menuitem2">
        </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-home">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Home Mailing Address</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-work">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Work Mailing Address</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-other">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Other Mailing Address</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="menuitem3">
        </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-notes">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Notes</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="menuitem-config-certs">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="1">Show Certificates</property>
            <property name="use_underline">True</property>
          </object>
        </child>
      </object>
    </property>
  </object>
  <object class="GtkListStore" id="model1">
    <columns>
      <column type="gchararray" />
    </columns>
  </object>
  <object class="GtkMenuButton" id="button-config">
    <property name="focusable">1</property>
    <property name="tooltip_text" translatable="1">Options</property>
    <property name="halign">end</property>
    <property name="valign">center</property>
    <property name="use_underline">1</property>
    <property name="direction">up</property>
    <child>
      <object class="GtkImage" id="gears-icon">
        <property name="icon_name">emblem-system-symbolic</property>
        <property name="icon_size">normal</property>
      </object>
    </child>
    <style>
      <class name="image-button" />
    </style>
  </object>
  <object class="GtkButton" id="button-cancel">
    <property name="label" translatable="1">_Cancel</property>
    <property name="focusable">1</property>
    <property name="use_underline">1</property>
  </object>
  <object class="GtkButton" id="button-ok">
    <property name="label" translatable="1">_Save</property>
    <property name="focusable">1</property>
    <property name="use_underline">1</property>
  </object>
  <object class="GtkButton" id="button-help">
    <property name="focusable">1</property>
    <property name="use_underline">1</property>
    <child>
      <object class="GtkImage" id="help-icon">
        <property name="icon_name">help-browser</property>
        <property name="icon_size">normal</property>
      </object>
    </child>
    <style>
      <class name="image-button" />
    </style>
  </object>
  <object class="GtkBox" id="contact-editor-box">
    <property name="orientation">vertical</property>
    <property name="hexpand">1</property>
    <property name="vexpand">1</property>
    <child>
      <object class="GtkNotebook" id="notebook11">
        <property name="vexpand">1</property>
        <property name="focusable">1</property>
        <property name="margin-bottom">12</property>
        <property name="margin-top">12</property>
        <property name="margin-end">12</property>
        <property name="margin-start">12</property>
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkScrolledWindow" id="scrolledwindow1">
                <property name="min_content_width">320</property>
                <property name="min_content_height">240</property>
                <property name="hexpand">1</property>
                <property name="vexpand">1</property>
                <property name="child">
                  <object class="GtkViewport" id="viewport1">
                    <property name="child">
                      <object class="GtkBox" id="vbox33">
                        <property name="orientation">vertical</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-start">12</property>
                        <property name="spacing">1</property>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <child>
                          <object class="GtkBox" id="hbox55">
                            <property name="valign">center</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkButton" id="button-image">
                                <property name="focusable">1</property>
                                <child>
                                  <object class="EImageChooser" type-func="e_image_chooser_get_type" id="image-chooser">
                                    <property name="visible">True</property>
                                  </object>
                                </child>
                                <accessibility>
                                  <property name="label" translatable="1">Image</property>
                                </accessibility>
                              </object>
                            </child>
                            <child>
                              <object class="GtkGrid">
                                <property name="hexpand">1</property>
                                <property name="column_spacing">6</property>
                                <property name="row_spacing">6</property>
                                <child>
                                  <object class="GtkLabel" id="label-nickname">
                                    <property name="label" translatable="1">Nic_kname:</property>
                                    <property name="use_underline">1</property>
                                    <property name="mnemonic_widget">entry-nickname</property>
                                    <property name="xalign">1</property>
                                    <layout>
                                      <property name="row">0</property>
                                      <property name="column">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="entry-fullname">
                                    <property name="name">fullname</property>
                                    <property name="focusable">1</property>
                                    <property name="hexpand">1</property>
                                    <accessibility>
                                      <relation name="labelled-by">button-fullname</relation>
                                    </accessibility>
                                    <layout>
                                      <property name="row">0</property>
                                      <property name="column">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="accellabel-fileas">
                                    <property name="label" translatable="1">_File under:</property>
                                    <property name="use_underline">1</property>
                                    <property name="mnemonic_widget">combo-file-as</property>
                                    <property name="xalign">1</property>
                                    <layout>
                                      <property name="row">1</property>
                                      <property name="column">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="where-label">
                                    <property name="label" translatable="1">_Where:</property>
                                    <property name="use_underline">1</property>
                                    <property name="xalign">1</property>
                                    <layout>
                                      <property name="column">2</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="button-categories">
