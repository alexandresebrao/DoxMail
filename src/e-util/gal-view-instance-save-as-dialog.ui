<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkBox" id="vbox-top">
    <property name="orientation">vertical</property>
    <property name="margin-bottom">5</property>
    <property name="margin-top">5</property>
    <property name="margin-end">5</property>
    <property name="margin-start">5</property>
    <property name="spacing">12</property>
    <child>
      <object class="GtkBox" id="vbox1">
        <property name="orientation">vertical</property>
        <property name="valign">center</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkCheckButton" id="radiobutton-create">
            <property name="valign">center</property>
            <property name="label" translatable="1">_Create new view</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
            <property name="active">1</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="alignment1">
            <property name="orientation">vertical</property>
            <property name="vexpand">1</property>
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="margin-start">24</property>
            <child>
              <object class="GtkBox" id="hbox1">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label8">
                    <property name="halign">center</property>
                    <property name="label" translatable="1">_Name:</property>
                    <property name="use_underline">1</property>
                    <property name="mnemonic_widget">entry-create</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="entry-create">
                    <property name="hexpand">1</property>
                    <property name="sensitive">0</property>
                    <property name="focusable">1</property>
                    <property name="invisible_char">●</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="vbox2">
        <property name="orientation">vertical</property>
        <property name="vexpand">1</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkCheckButton" id="radiobutton-replace">
            <property name="valign">center</property>
            <property name="label" translatable="1">_Replace existing view</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
            <property name="group">radiobutton-create</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="alignment2">
            <property name="orientation">vertical</property>
            <property name="vexpand">1</property>
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="margin-start">24</property>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow2">
                <property name="focusable">1</property>
                <property name="child">
                  <object class="GtkTreeView" id="custom-replace">
                    <property name="focusable">1</property>
                    <child internal-child="selection">
                      <object class="GtkTreeSelection" />
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>