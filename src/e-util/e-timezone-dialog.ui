<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkDialog" id="timezone-dialog">
    <property name="title" translatable="1">Select a Time Zone</property>
    <property name="default_width">500</property>
    <property name="default_height">400</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkBox" id="timezone-table">
            <property name="vexpand">1</property>
            <property name="margin-bottom">12</property>
            <property name="margin-top">12</property>
            <property name="margin-end">12</property>
            <property name="margin-start">12</property>
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkBox" id="hbox3">
                <property name="valign">center</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkImage" id="image1">
                    <property name="halign">center</property>
                    <property name="margin-end">0</property>
                    <property name="margin-start">0</property>
                    <property name="margin-bottom">0</property>
                    <property name="margin-top">0</property>
                    <property name="icon_name">dialog-information</property>
                    <property name="icon_size">large</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label1">
                    <property name="halign">center</property>
                    <property name="margin-end">0</property>
                    <property name="margin-start">0</property>
                    <property name="margin-bottom">0</property>
                    <property name="margin-top">0</property>
                    <property name="label" translatable="1">Use the left mouse button to zoom in on an area of the map and select a time zone.
Use the right mouse button to zoom out.</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label4">
                <property name="valign">center</property>
                <property name="margin-end">0</property>
                <property name="margin-start">0</property>
                <property name="margin-bottom">0</property>
                <property name="margin-top">0</property>
                <property name="label" translatable="1">Time Zones</property>
                <property name="xalign">0</property>
                <attributes>
                  <attribute name="weight" value="bold" />
                </attributes>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbox2">
                <property name="vexpand">1</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel" id="label5">
                    <property name="halign">center</property>
                    <property name="margin-end">0</property>
                    <property name="margin-start">0</property>
                    <property name="margin-bottom">0</property>
                    <property name="margin-top">0</property>
                    <property name="label"> </property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="vbox1">
                    <property name="hexpand">1</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkScrolledWindow" id="map-window">
                        <property name="vexpand">1</property>
                        <property name="focusable">1</property>
                        <property name="hscrollbar_policy">always</property>
                        <property name="vscrollbar_policy">always</property>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="preview-label">
                        <property name="valign">center</property>
                        <property name="margin-end">0</property>
                        <property name="margin-start">0</property>
                        <property name="margin-bottom">0</property>
                        <property name="margin-top">0</property>
                        <property name="label">America/New_York</property>
                        <property name="xalign">0</property>
                        <property name="yalign">0</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label3">
                <property name="valign">center</property>
                <property name="margin-end">0</property>
                <property name="margin-start">0</property>
                <property name="margin-bottom">0</property>
                <property name="margin-top">0</property>
                <property name="label" translatable="1">_Selection</property>
                <property name="use_underline">1</property>
                <property name="justify">center</property>
                <property name="mnemonic_widget">timezone-combo</property>
                <property name="xalign">0</property>
                <attributes>
                  <attribute name="weight" value="bold" />
                </attributes>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbox1">
                <property name="valign">center</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel" id="label6">
                    <property name="halign">center</property>
                    <property name="margin-end">0</property>
                    <property name="margin-start">0</property>
                    <property name="margin-bottom">0</property>
                    <property name="margin-top">0</property>
                    <property name="label"> </property>
                  </object>
                </child>
                <child>
                  <object class="GtkComboBox" id="timezone-combo">
                    <property name="hexpand">1</property>
                    <accessibility>
                      <property name="label" translatable="1">Timezone drop-down combination box</property>
                    </accessibility>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-2">cancel-button</action-widget>
      <action-widget response="-3">ok-button</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area1">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <child>
          <object class="GtkButton" id="cancel-button">
            <property name="hexpand">1</property>
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="ok-button">
            <property name="hexpand">1</property>
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
          </object>
        </child>
        <property name="halign">end</property>
      </object>
    </child>
  </object>
</interface>